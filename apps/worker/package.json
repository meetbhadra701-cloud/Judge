{
  "name": "@judge-copilot/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Judge Copilot background worker. M0: boots and shuts down cleanly; no job handlers exist yet.",
  "scripts": {
    "dev": "tsx watch --conditions=@judge-copilot/source src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@judge-copilot/shared": "workspace:*"
  }
}
