{
  "name": "@judge-copilot/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Judge Copilot background worker. M0: boots and shuts down cleanly; no job handlers exist yet.",
  "scripts": {
    "dev": "tsx watch --conditions=@judge-copilot/source src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@judge-copilot/audit": "workspace:*",
    "@judge-copilot/capture": "workspace:*",
    "@judge-copilot/database": "workspace:*",
    "@judge-copilot/deployment": "workspace:*",
    "@judge-copilot/devpost": "workspace:*",
    "@judge-copilot/domain": "workspace:*",
    "@judge-copilot/github": "workspace:*",
    "@judge-copilot/safe-http": "workspace:*",
    "@judge-copilot/schemas": "workspace:*",
    "@judge-copilot/shared": "workspace:*",
    "@judge-copilot/video": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@judge-copilot/evidence": "workspace:*",
    "postgres": "^3.4.9"
  }
}
