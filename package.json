{
  "name": "judge-copilot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck && tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @judge-copilot/database run db:generate",
    "db:migrate": "pnpm --filter @judge-copilot/database run db:migrate",
    "db:check": "pnpm --filter @judge-copilot/database run db:check",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm db:check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@next/eslint-plugin-next": "16.3.8",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "globals": "^17.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
