# Judge Copilot — environment (M2).
# Copy to `.env` for local development. Never commit real values.
#
# No model-provider credentials exist (no model calls before M5).

# Runtime environment: development | test | production
NODE_ENV=development

# Structured log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# API server bind address (apps/api).
API_HOST=127.0.0.1
API_PORT=3001

# PostgreSQL connection string. Required by `pnpm db:migrate` and by the API's Event Context
# routes (M1). Without it the API still boots and serves /health; Event Context routes return 503.
# Example: postgres://judge:judge@127.0.0.1:5432/judge_copilot
DATABASE_URL=

# Event Context extractor for the API build route:
#   none   (default) — no extractor; drafts are authored by hand.
#   replay — development only: replays recorded synthetic extractions when sources match exactly.
EVENT_CONTEXT_EXTRACTOR=none
# Required when EVENT_CONTEXT_EXTRACTOR=replay, e.g. tests/fixtures/event-context
EVENT_CONTEXT_REPLAY_DIR=

# API authentication (M2): none (default, fails closed) | jwt | dev (development only).
AUTH_MODE=none
# Required when AUTH_MODE=jwt.
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
AUTH_JWKS_URL=
AUTH_JWT_ROLES_CLAIM=roles

# Web UI (apps/web): server-side base URL of the API and the bearer credential it forwards
# (locally `dev-organizer` with AUTH_MODE=dev). Never exposed to the browser.
JUDGE_API_URL=http://127.0.0.1:3001
JUDGE_API_TOKEN=

# Capture worker (apps/worker, M2).
# Optional read-only GitHub token; public repositories need none. Never logged or stored.
GITHUB_TOKEN=
CAPTURE_CONCURRENCY=3
CAPTURE_POLL_INTERVAL_MS=2000
CAPTURE_LEASE_MS=300000
# live (default) | fixture (development only: synthetic network, refused in production)
CAPTURE_NETWORK=live
CAPTURE_FIXTURE_DIR=

# Optional: a DISPOSABLE PostgreSQL database for the real-Postgres migration test.
# The database name must end in `_test`; the test drops and recreates its schemas.
TEST_DATABASE_URL=
