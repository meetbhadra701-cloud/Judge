{
  "name": "@judge-copilot/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Authentication adapters for the AuthVerifier port: provider-neutral JWT/JWKS verification and an explicit development-only verifier. Layer 3 (I/O adapter).",
  "exports": {
    ".": {
      "@judge-copilot/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@judge-copilot/domain": "workspace:*",
    "@judge-copilot/schemas": "workspace:*",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  }
}
