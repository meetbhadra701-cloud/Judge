{
  "name": "@judge-copilot/safe-http",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "SSRF-safe HTTP client: URL and IP policy, DNS resolution with pinned connections, manual redirect validation, timeouts, body and content-type limits. Layer 3 (I/O adapter).",
  "exports": {
    ".": {
      "@judge-copilot/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@judge-copilot/capture": "workspace:*",
    "@judge-copilot/schemas": "workspace:*",
    "ipaddr.js": "^2.5.0"
  }
}
