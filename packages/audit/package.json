{
  "name": "@judge-copilot/audit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Append-only audit event contract. Layer 2 (deterministic core): no I/O; persistence adapters implement AuditSink.",
  "exports": {
    ".": {
      "@judge-copilot/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
