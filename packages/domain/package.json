{
  "name": "@judge-copilot/domain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Judge Copilot domain primitives and lifecycle classifications. Layer 1: depends only on @judge-copilot/schemas.",
  "exports": {
    ".": {
      "@judge-copilot/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@judge-copilot/schemas": "workspace:*"
  }
}
